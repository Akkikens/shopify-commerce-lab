# Nothing here is secret. The storefront runs against a public mock.shop catalog
# with no Shopify account. ClickyCanvas is mock.shop's mechanical-keyboard store.
PUBLIC_STORE_DOMAIN=mechanical-keyboards.mock.shop

# mock.shop is tokenless. For a real store, add the Storefront API public token
# (Headless channel). Keep it commented out until you have one — an empty value
# is rejected by the client.
# PUBLIC_STOREFRONT_API_TOKEN=
